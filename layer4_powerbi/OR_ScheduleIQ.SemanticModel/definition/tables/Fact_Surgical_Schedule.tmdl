	partition Fact_Surgical_Schedule = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "simulated\fact_simulated_schedule.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"case_id", Int64.Type}, {"replication", Int64.Type}, {"room_id", type text}, {"procedure_name", type text}, {"specialty", type text}, {"patient_id", Int64.Type}, {"asa_score", Int64.Type}, {"risk_tier", type text}, {"emergency_flag", type logical}, {"case_status", type text}, {"cancellation_reason", type text}, {"scheduled_date", type date}, {"scheduled_start_min", Int64.Type}, {"scheduled_end_min", Int64.Type}, {"actual_start_min", Int64.Type}, {"actual_end_min", Int64.Type}, {"scheduled_duration_min", Int64.Type}, {"actual_duration_min", type number}, {"overrun_min", type number}, {"turnover_min", type number}, {"pacu_start_min", Int64.Type}, {"pacu_end_min", Int64.Type}, {"pacu_duration_min", type number}, {"pacu_hold_flag", type logical}, {"icu_transfer_flag", type logical}, {"icu_los_hours", type number}, {"overtime_cost_inr", Int64.Type}, {"pacu_hold_cost_inr", Int64.Type}, {"sim_day", Int64.Type}, {"date_key", Int64.Type}, {"day_of_week", Int64.Type}, {"day_name", type text}, {"case_month", Int64.Type}, {"case_year", Int64.Type}, {"OT_Cost_INR", Int64.Type}, {"PACU_HoldCost_INR", Int64.Type}, {"ICU_Cost_INR", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

