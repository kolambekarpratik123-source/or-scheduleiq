	partition sim_daily_metrics = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "simulated\sim_daily_metrics.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"scheduled_date", type date}, {"date_key", Int64.Type}, {"total_cases", Int64.Type}, {"completed_cases", Int64.Type}, {"cancelled_cases", Int64.Type}, {"overrun_cases", Int64.Type}, {"total_overtime_min", type number}, {"avg_duration_min", type number}, {"pacu_holds", Int64.Type}, {"icu_transfers", Int64.Type}, {"total_pacu_hold_cost", Int64.Type}, {"total_overtime_cost", Int64.Type}, {"rooms_in_overtime", Int64.Type}, {"total_cost_inr", Int64.Type}, {"utilization_pct", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

